@layout Shared.BlankLayout
@page "/resumen"
@using blazor_factura.Data
@inject ServicioFacturas ServicioFacturas

<div class="apple-card">
    <div class="top-links">
        <a href="/facturas/nueva">← Volver a Factura</a> • <a href="/consultas">Consultas Inteligentes</a>
    </div>

    <h1>Reporte de Cliente</h1>

    <div style="display: flex; gap: 15px; margin-bottom: 20px;">
        <div class="form-group" style="flex: 1;">
            <label for="cliente">Cliente</label>
            <select id="cliente" @bind="clienteSeleccionado" @bind:after="ActualizarReporte">
                <option value="">-- Seleccione --</option>
                @if (listaClientes != null) {
                    @foreach (var c in listaClientes) { <option value="@c">@c</option> }
                }
            </select>
        </div>

        <div class="form-group" style="flex: 1;">
            <label for="anio">Año</label>
            <select id="anio" @bind="anioSeleccionado" @bind:after="ActualizarReporte">
                <option value="">-- Seleccione --</option>
                @if (listaAnios != null) {
                    @foreach (var a in listaAnios) { <option value="@a">@a</option> }
                }
            </select>
        </div>
    </div>

    @if (reporteListo)
    {
        <div class="add-panel" style="text-align: center; margin-bottom: 30px;">
            <label>Total Anual</label>
            <div style="font-size: 34px; font-weight: 800; color: var(--color-profundo);">@totalAnual.ToString("C")</div>
            <div style="color: var(--color-marron); font-size: 14px; margin-top: 5px;">
                Cliente: @clienteSeleccionado | Año: @anioSeleccionado
            </div>
        </div>

        <h3>Detalle Mensual</h3>
        @if (gastoMensual != null && gastoMensual.Any())
        {
            <ul class="apple-list">
                @foreach (var item in gastoMensual)
                {
                    <li>
                        <span>@item.Periodo</span>
                        <strong>@item.TotalGastado.ToString("C")</strong>
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="text-align: center; color: #999;">No hay movimientos en este periodo.</p>
        }
    }
    else
    {
        <p style="text-align: center; color: #999; margin-top: 40px;">
            Seleccione un cliente y un año para ver el reporte.
        </p>
    }
</div>

@code {
    // El código C# sigue idéntico
    private List<string> listaClientes;
    private List<string> listaAnios;
    private string clienteSeleccionado = "";
    private string anioSeleccionado = "";
    private List<ResumenGasto> gastoMensual;
    private decimal totalAnual = 0;
    private bool reporteListo = false;

    protected override async Task OnInitializedAsync()
    {
        listaClientes = await ServicioFacturas.ObtenerClientesAsync();
        listaAnios = await ServicioFacturas.ObtenerAniosDisponiblesAsync();
    }

    private async Task ActualizarReporte()
    {
        gastoMensual = null;
        totalAnual = 0;
        reporteListo = false;

        if (!string.IsNullOrEmpty(clienteSeleccionado) && !string.IsNullOrEmpty(anioSeleccionado))
        {
            gastoMensual = await ServicioFacturas.ObtenerGastoMensualAsync(clienteSeleccionado, anioSeleccionado);
            totalAnual = gastoMensual.Sum(item => item.TotalGastado);
            reporteListo = true;
        }
    }
}