@page "/resumen"
@layout Shared.BlankLayout
@using blazor_factura.Data
@inject ServicioFacturas ServicioFacturas

<a href="/facturas/nueva">Regresar a Crear Factura</a>
<hr />

<h1>Resumen de Gastos por Cliente</h1>

<label for="cliente">Seleccione un cliente:</label>
<select id="cliente" @bind="clienteSeleccionado" @bind:after="ActualizarReporte">
    <option value="">-- Seleccione Cliente --</option>
    @if (listaClientes != null)
    {
        @foreach (var cliente in listaClientes)
        {
            <option value="@cliente">@cliente</option>
        }
    }
</select>

<label for="anio">Seleccione un año:</label>
<select id="anio" @bind="anioSeleccionado" @bind:after="ActualizarReporte">
    <option value="">-- Seleccione Año --</option>
    @if (listaAnios != null)
    {
        @foreach (var anio in listaAnios)
        {
            <option value="@anio">@anio</option>
        }
    }
</select>

@if (reporteListo)
{
    <hr />
    <h2>Reporte para: @clienteSeleccionado (@anioSeleccionado)</h2>

    <h3>Total del Año: @totalAnual.ToString("C")</h3>
    
    <hr />

    <h3>Detalle por Mes</h3>
    @if (gastoMensual == null)
    {
        <p>Cargando...</p>
    }
    else if (!gastoMensual.Any())
    {
        <p>No hay gastos registrados para este cliente en este año.</p>
    }
    else
    {
        <table border="1" cellpadding="5">
            <thead>
                <tr>
                    <th>Mes (YYYY-MM)</th>
                    <th>Total Gastado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in gastoMensual)
                {
                    <tr>
                        <td>@item.Periodo</td>
                        <td>@item.TotalGastado.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}


@code {
    // Listas para los dropdowns
    private List<string> listaClientes;
    private List<string> listaAnios;
    
    // Variables de estado
    private string clienteSeleccionado = "";
    private string anioSeleccionado = "";
    
    // Datos del reporte
    private List<ResumenGasto> gastoMensual;
    private decimal totalAnual = 0;
    private bool reporteListo = false;

    // Al cargar la página, obtenemos las listas para los dropdowns
    protected override async Task OnInitializedAsync()
    {
        listaClientes = await ServicioFacturas.ObtenerClientesAsync();
        listaAnios = await ServicioFacturas.ObtenerAniosDisponiblesAsync();
    }

    // Este método se llama CADA VEZ que cambias CUALQUIER dropdown
    private async Task ActualizarReporte()
    {
        // Reseteamos todo
        gastoMensual = null;
        totalAnual = 0;
        reporteListo = false;

        // Solo buscamos en la BD si AMBOS están seleccionados
        if (!string.IsNullOrEmpty(clienteSeleccionado) && !string.IsNullOrEmpty(anioSeleccionado))
        {
            // 1. Obtenemos el detalle mensual
            gastoMensual = await ServicioFacturas.ObtenerGastoMensualAsync(clienteSeleccionado, anioSeleccionado);
            
            // 2. Calculamos el total anual SUMANDO los meses (más eficiente)
            totalAnual = gastoMensual.Sum(item => item.TotalGastado);
            
            reporteListo = true;
        }
    }
}