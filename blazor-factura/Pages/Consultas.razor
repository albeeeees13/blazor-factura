@layout Shared.BlankLayout
@page "/consultas"
@using blazor_factura.Data
@inject ServicioFacturas ServicioFacturas

<div class="apple-card" style="max-width: 900px;">
    
    <div class="top-links">
        <a href="/facturas/nueva">← Volver a Factura</a> • <a href="/resumen">Ver Reportes</a>
    </div>

    <h1>Tablero de Inteligencia</h1>

    <div style="display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap; justify-content: center;">
        
        <div class="add-panel" style="text-align: center; min-width: 150px; margin-top:0;">
            <label>Ingresos Totales</label>
            <div style="font-size: 24px; font-weight: 800; color: var(--color-profundo);">@ingresosTotales.ToString("C")</div>
        </div>
        
        <div class="add-panel" style="text-align: center; min-width: 150px; margin-top:0;">
            <label>Ticket Promedio</label>
            <div style="font-size: 24px; font-weight: 800; color: var(--color-cobre);">@ticketPromedio.ToString("C")</div>
        </div>

        <div class="add-panel" style="text-align: center; min-width: 150px; margin-top:0;">
            <label>Prom. Artículos</label>
            <div style="font-size: 24px; font-weight: 800; color: var(--color-marron);">@promedioArticulos.ToString("N1")</div>
        </div>
    </div>

    <hr style="border: 0; border-top: 1px solid #e5e5ea; margin: 30px 0;" />

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">

        <div>
            <h3>📦 Más Vendidos</h3>
            <ul class="apple-list">
                @foreach (var item in topArticulos) {
                    <li><span>@item.Etiqueta</span> <strong>@item.Valor.ToString("N0") un.</strong></li>
                }
            </ul>
        </div>

        <div>
            <h3>💰 Más Rentables</h3>
            <ul class="apple-list">
                @foreach (var item in productosRentables) {
                    <li><span>@item.Etiqueta</span> <strong style="color:var(--color-cobre);">@item.Valor.ToString("C")</strong></li>
                }
            </ul>
        </div>

        <div>
            <h3>💎 Clientes VIP</h3>
            <ul class="apple-list">
                @foreach (var item in topClientes) {
                    <li><span>@item.Etiqueta</span> <strong>@item.Valor.ToString("C")</strong></li>
                }
            </ul>
        </div>

        <div>
            <h3>📅 Días Ocupados</h3>
            <ul class="apple-list">
                @foreach (var item in diasOcupados) {
                    <li><span>@item.Etiqueta</span> <strong>@item.Valor.ToString("N0") facturas</strong></li>
                }
            </ul>
        </div>

    </div>
</div>

@code {
    // El código C# sigue idéntico
    private List<DatoReporte> topArticulos = new();
    private List<DatoReporte> productosRentables = new();
    private List<DatoReporte> topClientes = new();
    private List<DatoReporte> diasOcupados = new();
    
    private decimal ticketPromedio = 0;
    private decimal ingresosTotales = 0;
    private decimal promedioArticulos = 0;

    protected override async Task OnInitializedAsync()
    {
        topArticulos = await ServicioFacturas.ObtenerTopArticulosAsync();
        ticketPromedio = await ServicioFacturas.ObtenerTicketPromedioAsync();
        ingresosTotales = await ServicioFacturas.ObtenerIngresosTotalesAsync();
        productosRentables = await ServicioFacturas.ObtenerProductosMasRentablesAsync();
        diasOcupados = await ServicioFacturas.ObtenerMejorDiaSemanaAsync();
        promedioArticulos = await ServicioFacturas.ObtenerPromedioArticulosPorFacturaAsync();
        topClientes = await ServicioFacturas.ObtenerTopClientesAsync();
    }
}}